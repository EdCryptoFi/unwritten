<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The daily spend run.

  Install (fills __REPO__ with this checkout's absolute path — launchd expands neither ~ nor $PWD):
    bash scripts/install-daily.sh

  Check:
    launchctl print gui/$(id -u)/com.unwritten.daily-spend | head -20
    tail -20 .daily.log

  Remove:
    launchctl bootout gui/$(id -u)/com.unwritten.daily-spend
    rm ~/Library/LaunchAgents/com.unwritten.daily-spend.plist

  __REPO__ is a placeholder rather than a committed absolute path: a path from one machine would
  publish its username, and would be wrong on every other machine anyway. If the repo moves, run the
  installer again.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.unwritten.daily-spend</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/daily.sh</string>
  </array>

  <!-- 10:00 local. If the Mac is asleep or powered off at that moment, launchd runs the job at
       the next opportunity instead of skipping the day — which is the reason this is a LaunchAgent
       and not a crontab entry. A missed day of chain history cannot be reconstructed. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- Safe because spend.mts is idempotent per UTC date: it asks the CHAIN whether today's
       transfers already landed and exits if they did. So a login or reboot can recover a day
       rather than double-spend one, and GitHub Actions can be armed at the same time. -->
  <key>RunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>StandardOutPath</key>
  <string>__REPO__/.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/.launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
