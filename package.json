{
  "name": "unwritten",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify": "tsx scripts/verify.mts",
    "spike": "tsx scripts/spike.mts",
    "seed": "tsx scripts/seed.mts",
    "secrets": "bash scripts/set-secrets.sh",
    "daily": "tsx scripts/spend.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsx": "^4.23.15",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "^0.1.8",
    "@mysten/sui": "^2",
    "@unwritten/chain": "workspace:^",
